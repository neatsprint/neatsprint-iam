SERVICE_NAME=iam
ENVIRONMENT=local
LOG_LEVEL=INFO
VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://neatsprint:neatsprint@postgres:5432/db_iam
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000

# Local development: generated on first start under the mounted keys volume.
JWT_PRIVATE_KEY_PATH=/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt-public.pem
JWT_ISSUER=neatsprint-iam
JWT_AUDIENCE=neatsprint
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Used by the seed script and operator tooling. Never enable in production.
BOOTSTRAP_TOKEN=dev-bootstrap-token-change-me
RUN_MIGRATIONS=true

# Email (Mailpit in development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="NeatSprint <no-reply@neatsprint.local>"
EMAIL_ENABLED=true
WEB_BASE_URL=http://localhost:3000

# Optional Google Identity Services sign-in
GOOGLE_CLIENT_ID=

# Optional Cloudflare Turnstile; auth endpoints skip CAPTCHA when empty
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Object storage for avatars
S3_ENDPOINT=http://minio:9000
S3_BUCKET=neatsprint
S3_ACCESS_KEY=neatsprint
S3_SECRET_KEY=neatsprint-dev-secret
S3_REGION=us-east-1

CORE_INTERNAL_URL=http://neatsprint-core:8000
SERVICE_TOKEN=dev-bootstrap-token-change-me
OUTBOX_ENABLED=true

METRICS_ENABLED=true
OTEL_ENABLED=false
